# Netflix Data Pipeline Configuration
# Copie este arquivo para .env e configure conforme necessário

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=Netflix
SPARK_EXECUTOR_MEMORY=2g

# Arquivo CSV de entrada
# Use um caminho absoluto ou relativo ao diretório do projeto
NETFLIX_INPUT_PATH=./data/input
NETFLIX_CSV_FILE=netflix_titles_clean.csv

# Dados de saída
NETFLIX_OUTPUT_PATH=./data/output

# PostgreSQL Configuration
JDBC_URL=jdbc:postgresql://localhost:5432/netflix_db
DB_USER=postgres
DB_PASSWORD=postgre123
